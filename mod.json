		"yellow-key": {
			"type": "keybind",
			"name": "Yellow Key",
			"default": "H"
		},
		"red-key": {
			"type": "keybind",
			"name": "Red Key",
			"default": "J"
		},
		"green-key": {
			"type": "keybind",
			"name": "Green Key",
			"default": "K"
		},
		"only-once": {
			"name": "Only Start Once",
			"description": "When u start a game and then re enter the level it wont be started anymore",
			"type": "bool",
			"default": false
		},
		"seed-offset": {
			"name": "Seed Offset",
			"type": "int",
			"description": "If u change this the inputs will change their path order",
			"default": 0
