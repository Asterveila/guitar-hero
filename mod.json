	"id": "zilko.geohero",
	"name": "GeoHero",
	"version": "v1.0.0",
	"developer": "Zilko",
	"description": "",
	"dependencies": {
		"cvolton.level-id-api": ">=2.0.0"
	},
	"resources": {
		"sprites": [
			"resources/icon.png"
		]
	},
	"settings": {
		"overlay-opacity": {
			"name": "Overlay Background Opacity",
			"type": "int",
