{
	"geode": "5.7.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "zilko.geohero",
	"name": "GeoHero",
	"version": "v1.0.1",
	"developer": "Zilko",
	"description": "make the game feel like a real rhythm game",
	"dependencies": {
		"cvolton.level-id-api": ">=2.0.0",
		"geode.node-ids": ">=1.23.3"
	},
	"links": {
		"source": "https://github.com/Zilko/guitar-hero",
		"community": "https://discord.gg/w6yvdzVzBd"
	},
	"tags": [
		"gameplay", "offline", "enhancement", "music"
	],
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"overlay-opacity": {
			"name": "Overlay Background Opacity",
			"type": "int",
			"default": 255,
			"max": 255,
			"min": 0,
			"control": {
				"slider": true,
				"arrows": false
			}
		},
		"speed": {
			"name": "Note Speed",
			"type": "float",
			"default": 3.5
		},
		"note-style": {
			"name": "Note Style",
			"type": "string",
			"default": "Circle",
			"one-of": ["Rounded Square", "Circle", "Square"]
		},
		"note-size": {
		    "name": "Note Size",
		    "description": "Visually scales notes and the input area. Doesn't affect hitboxes or timing.",
		    "type": "float",
		    "default": 1.0,
		    "min": 0.5,
		    "max": 2.0,
		    "control": { "slider": true }
		},
		"lane-split": {
		    "name": "Lane Split",
		    "description": "Spacing between lanes",
		    "type": "float",
		    "default": 30.0,
		    "min": 0.0,
		    "max": 100.0,
		    "control": { "slider": true }
		},
		"click-threshold": {
			"name": "Click Input Threshold (ms)",
			"description": "Holds shorter than the threshold will be considered a click, 0 for normal behavior",
			"type": "int",
			"default": 70
		},
		"show-accuracy": {
			"name": "Show Accuracy %",
			"type": "bool",
			"default": true
		},
		"show-combo": {
			"name": "Show Combo",
			"type": "bool",
			"default": true
		},
		"show-judgements": {
			"name": "Show Input Judgements",
			"type": "bool",
			"default": true
		},
		"blue-key": {
			"type": "keybind",
			"name": "Blue Lane Key",
			"default": "Left"
		},
		"yellow-key": {
			"type": "keybind",
			"name": "Yellow Lane Key",
			"default": "Up"
		},
		"red-key": {
			"type": "keybind",
			"name": "Red Lane Key",
			"default": "Right"
		},
		"green-key": {
			"type": "keybind",
			"name": "Green Lane Key",
			"default": "Down"
		},
		"any-key": {
			"name": "Any Key Works",
			"description": "Makes any key work as an input",
			"type": "bool",
			"default": {
				"android": true,
				"win": false,
				"mac": false,
				"ios": true
			}
		},
		"only-once": {
			"name": "Only Start Once",
			"description": "When u start a game and then re enter the level it wont be started anymore",
			"type": "bool",
			"default": false
		},
		"seed-offset": {
			"name": "Seed Offset",
			"type": "int",
			"description": "If u change this the inputs will change their path order",
			"default": 0
		}
	}
}
